PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=autocar
DB_USER=postgres
DB_PASSWORD=COLOQUE_SUA_SENHA_DO_POSTGRES
DB_SYNC_ALTER=true
DB_LOGGING=false
DB_SSL=false
# Para Supabase, use DB_SSL=true e configure o caminho do CA baixado no painel.
# DB_SSL_CA=certs/supabase-ca.crt
# Em hospedagem, também pode definir o conteúdo PEM diretamente:
# DB_SSL_CA_CONTENT=-----BEGIN CERTIFICATE-----...

JWT_SECRET=TROQUE_POR_UMA_CHAVE_GRANDE_E_ALEATORIA
APP_TIMEZONE=America/Belem
APP_UTC_OFFSET=-03:00

# Use * durante o desenvolvimento local. Em produção, informe as origens separadas por vírgula.
CORS_ORIGIN=*

# Imagens: local mantém os arquivos em uploads; supabase salva no Supabase Storage.
STORAGE_PROVIDER=local
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_STORAGE_BUCKET=product-images
# Use a Secret key (sb_secret_...) somente no backend, nunca no aplicativo/frontend.
SUPABASE_SECRET_KEY=COLOQUE_A_CHAVE_SECRETA_DO_BACKEND
